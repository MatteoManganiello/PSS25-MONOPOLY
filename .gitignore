# --- Gradle ---
.gradle/
build/
# Il wrapper va invece versionato, cosi' chi clona il progetto puo' compilarlo
# senza installare Gradle: le righe seguenti lo escludono dalle regole di ignore.
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat

